# Monitoring APIs (Windows host)
ZABBIX_URL=http://localhost:8085/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=CHANGE_ME
LOKI_URL=http://localhost:3100

# Local Ollama models. Pull the exact model tags before enabling the pipeline.
OLLAMA_URL=http://localhost:11434
LAYA_MODEL=laya
MINISTRAL_MODEL=ministral-3:3b
OLLAMA_TIMEOUT=90
LAYA_TIMEOUT=300

# Existing SSH port forwards
SSH_USER=aditya
SSH_PASSWORD=CHANGE_ME
# Prefer SSH key auth where available:
# SSH_KEY_FILE=C:/Users/your-user/.ssh/id_ed25519
FRONTEND_SSH_PORT=2223
BACKEND_SSH_PORT=2222
DATABASE_SSH_PORT=2224

# Automation policy
AUTOMATIC_REMEDIATION=true
ALLOW_BACKEND_RESTART=true
MIN_CLASSIFIER_CONFIDENCE=0.70
INCIDENT_COOLDOWN_SECONDS=180

CHECK_INTERVAL=15
REQUEST_TIMEOUT=8
MAX_LOG_LINES=35
