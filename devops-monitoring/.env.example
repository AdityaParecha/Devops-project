# Copy to .env and fill in. .env is git-ignored.

# Zabbix API (Zabbix web is published on host port 8085)
ZABBIX_URL=http://localhost:8085/api_jsonrpc.php
ZABBIX_USER=Admin
ZABBIX_PASSWORD=change-me

# Loki / Grafana
LOKI_URL=http://localhost:3100
GRAFANA_URL=http://localhost:3000

# SSH access to monitored VMs
SSH_USER=your-ssh-user
SSH_PASSWORD=change-me

# Used by docker-compose.yml
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
